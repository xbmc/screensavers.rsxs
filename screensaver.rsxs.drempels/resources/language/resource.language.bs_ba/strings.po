msgctxt "Addon Summary"
msgid "About as psychedelic as screensavers get"
msgstr "Otprilike najpsihodeličniji koliko čuvari ekrana mogu biti"

msgctxt "Addon Description"
msgid "This is about as psychedelic as screensavers get. mogumbo thought his Plasma saver was at the top of the scale, but this one is even more nauseating. You'd better find one of those air sickness bags before you stare at this one for too long."
msgstr "Ovo je psihodelično za koliko god čuvari ekrana mogu biti. Mogumbo je mislio da je njegov Plasma čuvar ekrana na vrhu ljestvice, ali ovaj je još mučeniji. Bolje vam je da nađete jednu od onih vrećica za mučninu od zraka prije nego što predugo buljite u ovu stravu."

msgctxt "Addon Disclaimer"
msgid "This is an implementation based on \"rss-glx\" screensaver"
msgstr "Ovo je implementacija zasnovana na \"rss-glx\" čuvaru ekrana"

# [Consistency] Make terms, settings names, brands and other minutiae, consistent throughout file.
# [Capitalization] Avoid capitalizing every second word. See http://grammarist.com/capitalization/
# For example, prefer wording as "This new string" instead of "This New String".
# [Referencing] If a suitable string already exists, reuse it, making a note of where it's used!
# [Description / location] For example, "#. Description of some setting" used on "#: xbmc/addons/guidialogaddoninfo.cpp"
# When writing a description or setting, refer to a setting name in quotes. See existing entries for guidance.
# For example, "Press \"OK\" for \"All seasons\"" instead of "Press OK for All seasons" after first word.
# Following strings used for addon settings dialog
#. Main category name on addon settings dialog
msgctxt "#30000"
msgid "General"
msgstr "Općenito"

#. Spinner to select number blurring
msgctxt "#30001"
msgid "Blur"
msgstr "Zamućenje"

#. Help text of number selection for blurring
msgctxt "#30002"
msgid "Blurring between frames"
msgstr "Zamućenje između kadrova"

#. Spinner to select render speed
msgctxt "#30003"
msgid "Speed"
msgstr "Brzina"

#. Setting help text for select render speed
msgctxt "#30004"
msgid "Speed of flow, bigger is faster"
msgstr "Brzina protoka, veće je brže"

#. Spinner to select scale factor
msgctxt "#30005"
msgid "Scale"
msgstr "Razmjera"

#. Help for scale factor selection
msgctxt "#30006"
msgid "Scale of flow, bigger is zoomed in"
msgstr "Skala protoka, veća je uvećana"

#. Spinner to select number of cells
msgctxt "#30007"
msgid "Cells"
msgstr "Ćelije"

#. Help for number of cells selection
msgctxt "#30008"
msgid "Number of cells (i.e. control points) in width/height in powers of two"
msgstr "Broj ćelija (tj. kontrolnih tačaka) u širini/visini u potencijama dva"

#. Spinner to select cell resolution
msgctxt "#30009"
msgid "Cell Resolution"
msgstr "Rezolucija ćelije"

#. Help for cell resolution selection
msgctxt "#30010"
msgid "Resolution of each cell in powers of two.  4 - 8"
msgstr "Rezolucija svake ćelije u stepenima dva. 4 - 8"

#. Boolean value to use images instead
msgctxt "#30011"
msgid "Use Images"
msgstr "Koristite slike"

#. Help for boolean to allow use of images
msgctxt "#30012"
msgid "Cycle through the images"
msgstr "Kružite kroz slike"

#. To open dialog for folder selection of images
msgctxt "#30013"
msgid "Images (when empty, Kodi fanart images are used)"
msgstr "Slike (kada je prazno, koriste se Kodi fanart slike)"

#. Help to folder selection
msgctxt "#30014"
msgid "Select the folder from which the images will be used"
msgstr "Odaberite mapu iz koje će se slike koristiti"

#. Folder selection dialog header
msgctxt "#30015"
msgid "Folder from which the images will be used"
msgstr "Folder iz kojeg će se koristiti slike"

#. Slider for texture change intervall in seconds
msgctxt "#30016"
msgid "Texture interval (s)"
msgstr "Interval teksture (s)"

#. Help to texture interval
msgctxt "#30017"
msgid "Seconds to dwell on each texture"
msgstr "Sekunde zadržavanja na svakoj teksturi"

#. Slider for texture fade intervall in 1/10 (shown as comma e.g. 0.1)
msgctxt "#30018"
msgid "Texture fade interval (s)"
msgstr "Interval blijeđenja teksture (s)"

#. Help to texture fade intervall in 1/10 (shown as comma e.g. 0.1)
msgctxt "#30019"
msgid "Fade time between subsequent textures, in tenths of second"
msgstr "Vrijeme postepenog prijelaza između uzastopnih tekstura, u desetinkama sekunde"

#. Spinner to select generated texture size
msgctxt "#30020"
msgid "Generated texture size"
msgstr "Generirana veličina teksture"

#. Help to generated texture size
msgctxt "#30021"
msgid "Resolution of randomly generated textures, in powers of two"
msgstr "Rezolucija nasumično generiranih tekstura, u stepenima dva"
